# All keys below are OPTIONAL. If none are set, the RAG assistant (rag/assistant.py)
# automatically falls back to a deterministic, offline, extractive answer built
# from the local TF-IDF knowledge-base search -- Procura works fully offline
# with zero paid dependency out of the box.
#
# Set ONE of these to enable a live LLM-generated answer instead.
# GROQ_API_KEY is checked first (fast + free), then ANTHROPIC_API_KEY, then OPENAI_API_KEY.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
